<?xml version="1.0" encoding="utf-8"?>
<!-- App icon: a simple leaf. Kept inside the 66dp safe zone so no launcher shape cuts it off. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- 85% size, centered, so the leaf has room inside round icons -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.85"
        android:scaleY="0.85">
        <!-- stem -->
        <path
            android:pathData="M33,75 L29,79"
            android:strokeColor="#9CCC65"
            android:strokeLineCap="round"
            android:strokeWidth="3.5" />
        <!-- leaf -->
        <path
            android:fillColor="#9CCC65"
            android:pathData="M33,75 C33,49 49,33 75,33 C75,59 59,75 33,75 Z" />
        <!-- center vein -->
        <path
            android:pathData="M37,71 L64,44"
            android:strokeColor="#1F4D32"
            android:strokeAlpha="0.55"
            android:strokeLineCap="round"
            android:strokeWidth="2.5" />
    </group>
</vector>
