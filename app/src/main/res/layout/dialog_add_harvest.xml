<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🌾 Log New Harvest"
        android:textColor="#1C2A20"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Crop Name -->
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="Select or Type Crop Name"
        app:boxStrokeColor="#2E7D32"
        app:hintTextColor="#2E7D32">

        <AutoCompleteTextView
            android:id="@+id/actvDialogCropName"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:completionThreshold="1"
            android:inputType="textCapWords" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Quantity (kg) -->
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Harvest Yield (Kilograms / kg)"
        app:boxStrokeColor="#2E7D32"
        app:hintTextColor="#2E7D32">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etDialogQuantity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Notes -->
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Notes (Optional)"
        app:boxStrokeColor="#2E7D32"
        app:hintTextColor="#2E7D32">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etDialogNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textMultiLine"
            android:maxLines="3" />
    </com.google.android.material.textfield.TextInputLayout>

</LinearLayout>
