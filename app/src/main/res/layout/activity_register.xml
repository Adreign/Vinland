<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F5EF"
    android:clipToPadding="false"
    android:fillViewport="true">

    <!--
        Same palette as the dashboard and login:
        Forest #1F4D32 | Fern #2E7D32 | Paper #F3F5EF | Ink #1C2A20 | Muted #5C6B5F | Line #E2E7DC
        Requires res/drawable/bg_choice_tile.xml (selected / unselected tile for the options in steps 3 and 4).
    -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header: rounded bottom edge. Negative top margin hides the top corners off-screen. -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-28dp"
            app:cardBackgroundColor="#1F4D32"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="32dp"
                android:paddingTop="76dp"
                android:paddingBottom="56dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    app:cardBackgroundColor="#26FFFFFF"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:importantForAccessibility="no"
                        android:text="🌿"
                        android:textSize="30sp" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="-0.01"
                    android:text="Create your account"
                    android:textAlignment="center"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Join Vinland's urban gardening community"
                    android:textAlignment="center"
                    android:textColor="#CDE8D0"
                    android:textSize="14sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Multi-step registration card: direct child of the root so the overlap is not clipped -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="-28dp"
            android:layout_marginEnd="20dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="24dp"
            app:cardElevation="4dp"
            app:strokeColor="#E2E7DC"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- Step progress -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvStepIndicator"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="Step 1 of 4: Account Authentication"
                        android:textColor="#2E7D32"
                        android:textSize="13sp" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progressStep"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:progress="25"
                        app:indicatorColor="#2E7D32"
                        app:trackColor="#E3F1E0"
                        app:trackCornerRadius="4dp"
                        app:trackThickness="6dp" />
                </LinearLayout>

                <!-- STEP 1: ACCOUNT AUTHENTICATION (Google or Email/Password) -->
                <LinearLayout
                    android:id="@+id/layoutStep1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="visible">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="Choose how to register"
                        android:textColor="#1C2A20"
                        android:textSize="18sp" />

                    <!-- Google / Gmail Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGoogleRegister"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="Register with Google"
                        android:textAllCaps="false"
                        android:textColor="#1C2A20"
                        android:textSize="15sp"
                        app:backgroundTint="@android:color/transparent"
                        app:cornerRadius="14dp"
                        app:strokeColor="#CFD6C9"
                        app:strokeWidth="1.5dp" />

                    <!-- Divider -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:layout_marginBottom="20dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1"
                            android:background="#E2E7DC" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="12dp"
                            android:text="or register with email"
                            android:textColor="#5C6B5F"
                            android:textSize="13sp" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1"
                            android:background="#E2E7DC" />
                    </LinearLayout>

                    <!-- First + last name side by side -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilFirstName"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:hint="First name"
                            app:boxCornerRadiusBottomEnd="12dp"
                            app:boxCornerRadiusBottomStart="12dp"
                            app:boxCornerRadiusTopEnd="12dp"
                            app:boxCornerRadiusTopStart="12dp"
                            app:boxStrokeColor="#2E7D32"
                            app:hintTextColor="#2E7D32">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etFirstName"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:autofillHints="givenName"
                                android:imeOptions="actionNext"
                                android:inputType="textPersonName|textCapWords"
                                android:textColor="#1C2A20" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilLastName"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:hint="Last name"
                            app:boxCornerRadiusBottomEnd="12dp"
                            app:boxCornerRadiusBottomStart="12dp"
                            app:boxCornerRadiusTopEnd="12dp"
                            app:boxCornerRadiusTopStart="12dp"
                            app:boxStrokeColor="#2E7D32"
                            app:hintTextColor="#2E7D32">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etLastName"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:autofillHints="familyName"
                                android:imeOptions="actionNext"
                                android:inputType="textPersonName|textCapWords"
                                android:textColor="#1C2A20" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <!-- Email -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilEmail"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:hint="Email address"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxStrokeColor="#2E7D32"
                        app:hintTextColor="#2E7D32">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etEmail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:autofillHints="emailAddress"
                            android:imeOptions="actionNext"
                            android:inputType="textEmailAddress"
                            android:textColor="#1C2A20" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Password -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilPassword"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:hint="Password"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxStrokeColor="#2E7D32"
                        app:endIconMode="password_toggle"
                        app:hintTextColor="#2E7D32">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etPassword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:autofillHints="newPassword"
                            android:imeOptions="actionNext"
                            android:inputType="textPassword"
                            android:textColor="#1C2A20" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Confirm Password -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilConfirmPassword"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:hint="Confirm password"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxStrokeColor="#2E7D32"
                        app:endIconMode="password_toggle"
                        app:hintTextColor="#2E7D32">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etConfirmPassword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:autofillHints="newPassword"
                            android:imeOptions="actionDone"
                            android:inputType="textPassword"
                            android:textColor="#1C2A20" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Step 1 Next Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnNextStep1"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="24dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="Next: Barangay"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        app:backgroundTint="#2E7D32"
                        app:cornerRadius="14dp" />
                </LinearLayout>

                <!-- STEP 2: BARANGAY SELECTION -->
                <LinearLayout
                    android:id="@+id/layoutStep2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="Select your barangay"
                        android:textColor="#1C2A20"
                        android:textSize="18sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="20dp"
                        android:text="Where in Quezon City is your garden located?"
                        android:textColor="#5C6B5F"
                        android:textSize="14sp" />

                    <!-- Barangay autocomplete -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilBarangay"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Search your barangay"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxStrokeColor="#2E7D32"
                        app:hintTextColor="#2E7D32">

                        <AutoCompleteTextView
                            android:id="@+id/actvBarangay"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:completionThreshold="1"
                            android:inputType="text"
                            android:textColor="#1C2A20" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Navigation Buttons Step 2 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnBackStep2"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="Back"
                            android:textAllCaps="false"
                            android:textColor="#1C2A20"
                            android:textSize="15sp"
                            app:backgroundTint="@android:color/transparent"
                            app:cornerRadius="14dp"
                            app:strokeColor="#CFD6C9"
                            app:strokeWidth="1.5dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnNextStep2"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1.6"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="Next: Garden type"
                            android:textAllCaps="false"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            app:backgroundTint="#2E7D32"
                            app:cornerRadius="14dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- STEP 3: GARDEN TYPOLOGY -->
                <LinearLayout
                    android:id="@+id/layoutStep3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="Choose your garden type"
                        android:textColor="#1C2A20"
                        android:textSize="18sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="20dp"
                        android:text="What type of garden setup do you cultivate?"
                        android:textColor="#5C6B5F"
                        android:textSize="14sp" />

                    <RadioGroup
                        android:id="@+id/rgGardenType"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <RadioButton
                            android:id="@+id/rbBackyard"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_choice_tile"
                            android:buttonTint="#2E7D32"
                            android:minHeight="56dp"
                            android:paddingHorizontal="14dp"
                            android:text="🏡  Backyard garden"
                            android:textColor="#1C2A20"
                            android:textSize="15sp" />

                        <RadioButton
                            android:id="@+id/rbRooftop"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/bg_choice_tile"
                            android:buttonTint="#2E7D32"
                            android:minHeight="56dp"
                            android:paddingHorizontal="14dp"
                            android:text="🏙️  Rooftop / balcony garden"
                            android:textColor="#1C2A20"
                            android:textSize="15sp" />

                        <RadioButton
                            android:id="@+id/rbCommunityPlot"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/bg_choice_tile"
                            android:buttonTint="#2E7D32"
                            android:minHeight="56dp"
                            android:paddingHorizontal="14dp"
                            android:text="🌾  Community plot"
                            android:textColor="#1C2A20"
                            android:textSize="15sp" />
                    </RadioGroup>

                    <!-- Navigation Buttons Step 3 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnBackStep3"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="Back"
                            android:textAllCaps="false"
                            android:textColor="#1C2A20"
                            android:textSize="15sp"
                            app:backgroundTint="@android:color/transparent"
                            app:cornerRadius="14dp"
                            app:strokeColor="#CFD6C9"
                            app:strokeWidth="1.5dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnNextStep3"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1.6"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="Next: Crops"
                            android:textAllCaps="false"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            app:backgroundTint="#2E7D32"
                            app:cornerRadius="14dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- STEP 4: CROPS TO GROW -->
                <LinearLayout
                    android:id="@+id/layoutStep4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="What crops do you grow?"
                        android:textColor="#1C2A20"
                        android:textSize="18sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="20dp"
                        android:text="Select the urban vegetables in your garden:"
                        android:textColor="#5C6B5F"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:id="@+id/layoutCropsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <CheckBox
                            android:id="@+id/cbTomato"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_choice_tile"
                            android:buttonTint="#2E7D32"
                            android:minHeight="56dp"
                            android:paddingHorizontal="14dp"
                            android:text="🍅  Tomato"
                            android:textColor="#1C2A20"
                            android:textSize="15sp" />

                        <CheckBox
                            android:id="@+id/cbGreenPepper"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/bg_choice_tile"
                            android:buttonTint="#2E7D32"
                            android:minHeight="56dp"
                            android:paddingHorizontal="14dp"
                            android:text="🫑  Green pepper"
                            android:textColor="#1C2A20"
                            android:textSize="15sp" />
                    </LinearLayout>

                    <!-- Navigation Buttons Step 4 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnBackStep4"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="Back"
                            android:textAllCaps="false"
                            android:textColor="#1C2A20"
                            android:textSize="15sp"
                            app:backgroundTint="@android:color/transparent"
                            app:cornerRadius="14dp"
                            app:strokeColor="#CFD6C9"
                            app:strokeWidth="1.5dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnRegister"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1.6"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="Create account"
                            android:textAllCaps="false"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            app:backgroundTint="#2E7D32"
                            app:cornerRadius="14dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Error / status text -->
                <TextView
                    android:id="@+id/tvError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:textAlignment="center"
                    android:textColor="#B3261E"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <ProgressBar
                    android:id="@+id/progressBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="16dp"
                    android:indeterminateTint="#2E7D32"
                    android:visibility="gone" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvGoToLogin"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="32dp"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="Already have an account? Log in"
            android:textColor="#2E7D32"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>