// ---------------------------------------------------------------------------
// AI recommendations: paste these blocks INSIDE your existing
//   service cloud.firestore { match /databases/{database}/documents { ... } }
// in Firebase Console > Firestore > Rules. Do not replace your other rules.
// The Cloud Function uses the Admin SDK, which bypasses rules, so it can still write.
// ---------------------------------------------------------------------------

// Cached recommendation: the signed-in owner can read it; nobody can write from the app.
match /users/{uid}/ai_recommendations/{docId} {
  allow read: if request.auth != null && request.auth.uid == uid;
  allow write: if false;
}

// Usage counters and token totals: server only.
match /ai_usage/{uid} {
  allow read, write: if false;
}
match /ai_usage_global/{day} {
  allow read, write: if false;
}

// NOTE: if your existing rules contain a broad wildcard such as
//   match /users/{uid}/{document=**} { allow read, write: if request.auth.uid == uid; }
// that rule would still let the user WRITE their own cache document (Firestore
// allows an action if ANY matching rule allows it). Change that wildcard so it
// does not cover ai_recommendations, e.g. list subcollections explicitly
// (soil_logs, harvest_logs, notifications).
